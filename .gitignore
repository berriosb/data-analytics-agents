node_modules/
*.log
.DS_Store

# Python caches (the toolkit ships Python snippets in skills/; users may
# import them locally for validation — these appear when they do).
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Per-CLI install artifacts (regenerated by `make install-all` / `npm run install`).
# These are the symlink trees that bin/install.js creates for OpenCode, Claude Code
# and Codex at the project-local level. Committing them is a personal preference;
# they live in version control on a per-team basis.
.opencode/
.claude/
.agents/

# Local user-specific overrides (never commit).
.opencode.local.*
.claude.local.*

# IDE settings.
.vscode/
.idea/

# Environment files (the toolkit has no secrets of its own; this is hygiene).
.env
.env.local
.env.*.local

# Backup / editor temp files.
*.bak
*.swp
*~

# Output regenerable de los smoke tests (lo regenera `make test-*`).
examples/excel_sample/*_profile.md
examples/excel_sample/*_profile.json
examples/report_export_sample/out/
examples/excel_formulas_sample/revenue_q2_2026_with_formulas_formulas.md

# Sample regenerable — `make test-export-*` lo regenera si falta.
examples/report_export_sample/charts/

# Mock warehouse SQLite generado por demo_sqlite_mock.py (se recrea al correr).
examples/sql_cloud_warehouse_sample/mock_warehouse.sqlite
examples/sql_write_sample/demo_results.sqlite

# API generada por api-builder (se regenera via make test-api-builder).
examples/api_builder_sample/out_api/
