# sql-cloud-warehouse — env vars de ejemplo
# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees .env con valores reales.

# === Target (elegir uno) ===
# WAREHOUSE_TYPE=snowflake
# WAREHOUSE_TYPE=bigquery
# WAREHOUSE_TYPE=redshift

# === Snowflake ===
# SNOWFLAKE_ACCOUNT=tu-account.region
# SNOWFLAKE_USER=tu-usuario
# SNOWFLAKE_PASSWORD=tu-password
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=ANALYTICS
# SNOWFLAKE_SCHEMA=PUBLIC

# === BigQuery ===
# WAREHOUSE_PROJECT=tu-proyecto-gcp
# WAREHOUSE_DATASET=tu_dataset
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/local/al/service-account.json

# === Redshift ===
# REDSHIFT_HOST=redshift-cluster.xxx.region.redshift.amazonaws.com
# REDSHIFT_PORT=5439
# REDSHIFT_USER=tu-usuario
# REDSHIFT_PASSWORD=tu-password
# REDSHIFT_DATABASE=analytics

# === Databricks (Spark SQL) ===
# DATABRICKS_SERVER_HOSTNAME=dbc-xxx.cloud.databricks.com
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxx
# DATABRICKS_TOKEN=dapi_tu_token_personal_o_service_principal
# DATABRICKS_CATALOG=main
# DATABRICKS_SCHEMA=default