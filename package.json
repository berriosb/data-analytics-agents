{
  "name": "data-analytics-agents",
  "version": "0.5.0",
  "description": "Toolkit multi-CLI de personas y skills para flujos de trabajo de data analytics (OpenCode, Claude Code, Codex, Antigravity). v0.5.0 cierra el ciclo end-to-end: excel-profiler + report-export + sql-cloud-warehouse + api-builder.",
  "type": "module",
  "bin": {
    "data-analytics-agents": "./bin/install.js"
  },
  "files": [
    "bin",
    "agents",
    "skills",
    "adapters",
    "examples",
    "docs",
    ".github",
    "README.md",
    "AGENTS.md",
    "Makefile",
    "LICENSE"
  ],
  "peerDependencies": {
    "openpyxl": "^3.1.0",
    "pandas": "^2.0.0",
    "xlrd": "^2.0.0",
    "plotly": "^5.0.0",
    "kaleido": "^0.2.0",
    "python-pptx": "^0.6.0",
    "weasyprint": "^60.0",
    "pdfkit": "^1.0.0",
    "beautifulsoup4": "^4.12.0",
    "sqlalchemy": "^2.0.0",
    "snowflake-connector-python": "^3.0.0",
    "sqlalchemy-bigquery": "^1.6.0",
    "google-cloud-bigquery": "^3.0.0",
    "sqlalchemy-redshift": "^0.8.0",
    "redshift-connector": "^2.0.0",
    "fastapi": "^0.110.0",
    "uvicorn": "^0.27.0",
    "httpx": "^0.27.0"
  },
  "peerDependenciesMeta": {
    "openpyxl": {"optional": true},
    "pandas": {"optional": true},
    "xlrd": {"optional": true},
    "plotly": {"optional": true},
