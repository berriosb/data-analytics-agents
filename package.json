    "redshift-connector": {"optional": true},
    "fastapi": {"optional": true},
    "uvicorn": {"optional": true},
    "httpx": {"optional": true}
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:opencode": "node ./bin/install.js install --opencode",
    "install:claude": "node ./bin/install.js install --claude",
    "install:codex": "node ./bin/install.js install --codex",
    "install:agy": "node ./bin/install.js install --agy",
    "uninstall": "node ./bin/install.js uninstall",
    "list": "node ./bin/install.js list"
  },
  "keywords": [
    "agents",
    "skills",
