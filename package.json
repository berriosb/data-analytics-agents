{
  "name": "data-analytics-agents",
  "version": "0.1.0",
  "description": "Toolkit multi-CLI de personas y skills para flujos de trabajo de data analytics (OpenCode, Claude Code, Codex, Antigravity).",
  "type": "module",
  "bin": {
    "data-analytics-agents": "./bin/install.js"
  },
  "files": [
    "bin",
    "agents",
    "skills",
    "adapters",
    ".github",
    "README.md",
    "AGENTS.md",
    "Makefile",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install": "node ./bin/install.js install",
    "install:opencode": "node ./bin/install.js install --opencode",
    "install:claude": "node ./bin/install.js install --claude",
    "install:codex": "node ./bin/install.js install --codex",
    "install:agy": "node ./bin/install.js install --agy",
    "uninstall": "node ./bin/install.js uninstall",
    "list": "node ./bin/install.js list"
  },
  "keywords": [
    "agents",
    "skills",
    "data-analytics",
    "opencode",
    "claude-code",
    "codex",
    "antigravity",
    "csv-profiler",
    "sql-analyst",
    "agent-skills",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/berriosb/data-analytics-agents.git"
  },
  "bugs": {
    "url": "https://github.com/berriosb/data-analytics-agents/issues"
  },
  "homepage": "https://github.com/berriosb/data-analytics-agents#readme"
}
