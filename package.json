{
  "name": "data-analytics-agents",
  "version": "0.6.0",
  "description": "Toolkit multi-CLI de personas y skills para flujos de trabajo de data analytics (OpenCode, Claude Code, Codex, Antigravity). v0.6.0 agrega excel-formulas para auditoria de formulas Excel.",
  "type": "module",
  "bin": {
    "data-analytics-agents": "./bin/install.js"
  },
  "files": [
    "bin",
    "agents",
    "skills",
    "adapters",
    "docs",
    ".github",
    "README.md",
    "AGENTS.md",
    "Makefile",
    "LICENSE",
    "examples/api_builder_sample/analysis.py",
    "examples/api_builder_sample/build_demo.py",
    "examples/excel_sample/generate_sample.py",
    "examples/excel_sample/test_excel_profiler.py",
    "examples/excel_sample/ventas_q2_2026_dirty.xlsx",
    "examples/excel_formulas_sample/revenue_q2_2026_with_formulas.xlsx",
    "examples/excel_formulas_sample/generate_sample.py",
    "examples/excel_formulas_sample/demo_offline.py",
    "examples/report_export_sample/export_demo.py",
    "examples/report_export_sample/generate_sample.py",
    "examples/report_export_sample/insights.md",
    "examples/sql_cloud_warehouse_sample/demo_offline.py",
    "examples/sql_cloud_warehouse_sample/demo_sqlite_mock.py",
    "examples/sql_cloud_warehouse_sample/.env.example",
    "examples/notes_example.sqlite",
    "examples/ventas_sample.csv"
  ],
  "exclude": [
    "**/__pycache__",
    "**/*.pyc",
    "**/.pytest_cache",
    "examples/excel_sample/*_profile.*",
    "examples/report_export_sample/out/**",
    "examples/report_export_sample/charts/**",
    "examples/sql_cloud_warehouse_sample/mock_warehouse.sqlite",
    "examples/api_builder_sample/out_api/**",
    "skills_loader.py",
    "**/.env*",
    "**/*.log",
    "**/.DS_Store"
  ],
  "peerDependencies": {
    "openpyxl": "^3.1.0",
    "pandas": "^2.0.0",
    "xlrd": "^2.0.0",
    "formulas": "^1.2.0",
    "xlcalculator": "^0.5.0",
    "plotly": "^5.0.0",
    "kaleido": "^0.2.0",
    "python-pptx": "^0.6.0",
    "weasyprint": "^60.0",
    "pdfkit": "^1.0.0",
    "beautifulsoup4": "^4.12.0",
    "sqlalchemy": "^2.0.0",
    "snowflake-connector-python": "^3.0.0",
    "sqlalchemy-bigquery": "^1.6.0",
    "google-cloud-bigquery": "^3.0.0",
    "sqlalchemy-redshift": "^0.8.0",
    "redshift-connector": "^2.0.0",
    "fastapi": "^0.110.0",
    "uvicorn": "^0.27.0",
    "httpx": "^0.27.0"
  },
  "peerDependenciesMeta": {
    "openpyxl": {"optional": true},
    "pandas": {"optional": true},
    "xlrd": {"optional": true},
    "formulas": {"optional": true},
    "xlcalculator": {"optional": true},
    "plotly": {"optional": true},
    "kaleido": {"optional": true},
    "python-pptx": {"optional": true},
    "weasyprint": {"optional": true},
    "pdfkit": {"optional": true},
    "beautifulsoup4": {"optional": true},
    "sqlalchemy": {"optional": true},
    "snowflake-connector-python": {"optional": true},
    "sqlalchemy-bigquery": {"optional": true},
    "google-cloud-bigquery": {"optional": true},
    "sqlalchemy-redshift": {"optional": true},
    "redshift-connector": {"optional": true},
    "fastapi": {"optional": true},
    "uvicorn": {"optional": true},
    "httpx": {"optional": true}
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:opencode": "node ./bin/install.js install --opencode",
    "install:claude": "node ./bin/install.js install --claude",
    "install:codex": "node ./bin/install.js install --codex",
    "install:agy": "node ./bin/install.js install --agy",
    "uninstall": "node ./bin/install.js uninstall",
    "list": "node ./bin/install.js list"
  },
  "keywords": [
    "agents",
    "skills",
    "data-analytics",
    "opencode",
    "claude-code",
    "codex",
    "antigravity",
    "csv-profiler",
    "sql-analyst",
    "agent-skills",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/berriosb/data-analytics-agents.git"
  },
  "bugs": {
    "url": "https://github.com/berriosb/data-analytics-agents/issues"
  },
  "homepage": "https://github.com/berriosb/data-analytics-agents#readme"
}
